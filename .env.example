# EASY FREE-TIER DATABASE OPTION: SUPABASE
# Create a free Supabase project, run SUPABASE_SETUP.sql, then add these to Render Environment.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NODE_ENV=production
# No Render persistent disk is required when Supabase is configured.
